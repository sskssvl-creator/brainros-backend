# ==============================================================================
# Brainros Backend Environment Configuration Template
# Copy this file to .env or .env.production and fill in your real credentials.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://username:password@host:5432/database_name?sslmode=require"
DIRECT_URL="postgresql://username:password@host:5432/database_name?sslmode=require"

# Redis & Queue Configuration
# Set REDIS_ENABLED=false to run in fault-tolerant in-memory mode without Redis or BullMQ.
REDIS_ENABLED=true
REDIS_URL="redis://:password@host:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Authentication & JWT Secrets (CRITICAL: Change these in production!)
JWT_SECRET=""
JWT_ACCESS_SECRET=""
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"
SESSION_EXPIRY_DAYS=30

# Cookie Configuration
COOKIE_DOMAIN=""
COOKIE_SAME_SITE="lax"
COOKIE_SECURE=true

# Google OAuth Configuration
GOOGLE_CLIENT_ID=""

# CORS Configuration
# Comma-separated list of allowed frontend origins (no trailing slashes, no wildcard in prod)
FRONTEND_URL="https://brainros.com,https://www.brainros.com"

# Rate Limiting & Load Testing Whitelist
THROTTLE_TTL=60
THROTTLE_LIMIT=100
# Comma-separated list of test client IPs or '*' to whitelist from rate limiting during load tests
ALLOWED_TEST_IPS="115.42.40.90"

# Question Management Feature Flags
FEATURE_ADD_QUESTION=false
FEATURE_BULK_IMPORT_QUESTION=false
FEATURE_QUESTION_BANK=false
FEATURE_BULK_IMPORT_TRANSLATION=false

# ==============================================================================
# OTP Service Configuration (Twilio Verify)
# ==============================================================================
# Set BYPASS_OTP=true for development bypass (login with 123456, no Twilio SMS sent)
# Set BYPASS_OTP=false for production (real SMS sent via Twilio Verify)
BYPASS_OTP=false

DEV_BYPASS_OTP="123456"

# Twilio Verify Configuration (Used when BYPASS_OTP=false)
TWILIO_ACCOUNT_SID=""
TWILIO_API_KEY=""
TWILIO_API_SECRET=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# Twilio WhatsApp Messaging (separate from Verify — exam reminders & result notifications)
# SECURITY: TWILIO_AUTH_TOKEN must NEVER be committed to source control or logged.
# Get TWILIO_AUTH_TOKEN from: Twilio Console > Account Info > Auth Token
# TWILIO_AUTH_TOKEN is shared between sections above — define once only.
#
# WhatsApp sender — must be registered & approved as a WhatsApp Business Sender in Twilio Console
# For Twilio Sandbox testing only: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM="whatsapp:+918320982232"
# Twilio Content Template SIDs (optional — for approved WhatsApp Business templates in production)
# Leave blank to fall back to free-form text (Sandbox / development mode only)
TWILIO_WHATSAPP_EXAM_REMINDER_24H_CONTENT_SID=""
TWILIO_WHATSAPP_EXAM_REMINDER_1H_CONTENT_SID=""
TWILIO_WHATSAPP_RESULT_PUBLISHED_CONTENT_SID=""

# OTP Parameter Controls
OTP_LENGTH=5
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5

# Email & Resend Configuration
EMAIL_API_KEY=""
EMAIL_FROM="Brainros <noreply@yourdomain.com>"

# Storage / AWS S3 Configuration (Optional - falls back to local storage/reports if unset)
S3_BUCKET="brainros-reports"
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="us-east-1"
APP_URL="http://localhost:3000"

# Logging Configuration
LOG_LEVEL="info"
SLOW_REQUEST_THRESHOLD_MS=1000
ENABLE_HTTP_BODY_LOGGING=false

# Gemini AI Question Paper Translation & Diagnostic Exam Analysis Configuration
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_ANALYSIS_MODEL="gemini-3.5-flash-lite"
GEMINI_TRANSLATION_BATCH_SIZE=20
GEMINI_TRANSLATION_CONCURRENCY=1
GEMINI_RATE_LIMIT_ENABLED=true
GEMINI_REQUESTS_PER_INTERVAL=10
GEMINI_RATE_LIMIT_INTERVAL_MS=60000
GEMINI_MIN_REQUEST_INTERVAL_MS=2000
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BUFFER_MS=3000
